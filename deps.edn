{:paths ["src" "resources"]

 :deps
 {;; Schema validation
  metosin/malli {:mvn/version "0.20.1"}

  ;; Source code manipulation
  rewrite-clj/rewrite-clj {:mvn/version "1.2.54"}

  ;; Namespace reloading with proper protocol/multimethod handling
  io.github.tonsky/clj-reload {:mvn/version "1.0.0"}

  ;; HTML generation for reports
  hiccup/hiccup {:mvn/version "2.0.0"}

  ;; File watching for watch mode (used by Kaocha, better Mac support)
  com.nextjournal/beholder {:mvn/version "1.0.3"}

  ;; Reactive programming for worker supervision
  missionary/missionary {:mvn/version "b.47"}}

 :aliases
 {:dev
  {:extra-paths ["dev" "test"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}}

  ;; Tests require ClojureStorm since heretic depends on it
  :test
  {:extra-paths ["test"]
   :classpath-overrides {org.clojure/clojure nil}
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                com.github.flow-storm/clojure {:mvn/version "1.12.5"}}
   :jvm-opts ["-Dclojure.storm.instrumentEnable=false"]  ;; Disable during tests
   :main-opts ["-m" "kaocha.runner"]}

  ;; ClojureStorm for instrumentation-based coverage collection
  ;; This replaces the standard Clojure compiler with ClojureStorm
  :clojurestorm
  {:classpath-overrides {org.clojure/clojure nil}
   :extra-deps
   {;; ClojureStorm - patched Clojure compiler for instrumentation
    ;; Includes Emitter, Tracer, and FormRegistry APIs
    com.github.flow-storm/clojure {:mvn/version "1.12.5"}}

   :jvm-opts
   ["-Dclojure.storm.instrumentEnable=true"
    ;; Configure these per-project in heretic.edn
    ;; -Dclojure.storm.instrumentOnlyPrefixes=my-app
    ;; -Dclojure.storm.instrumentSkipPrefixes=my-app.test
    ]}

  ;; Combined alias for running tests with coverage collection
  :collect
  {:extra-paths ["test"]
   :extra-deps
   {lambdaisland/kaocha {:mvn/version "1.91.1392"}
    com.github.flow-storm/clojure {:mvn/version "1.12.5"}}
   :classpath-overrides {org.clojure/clojure nil}
   :jvm-opts
   ["-Dclojure.storm.instrumentEnable=true"]}}}
