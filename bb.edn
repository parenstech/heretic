{:paths ["src" "bb"]

 :deps
 {rewrite-clj/rewrite-clj {:mvn/version "1.1.47"}}

 :tasks
 {:requires [[babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.edn :as edn]
             [clojure.string :as str]]

  :init
  (do
    ;; heretic.sandbox owns the single ClojureStorm-flag builder
    ;; (sandbox/storm-jvm-opts); it loads under babashka (clojure.* deps only).
    (require '[heretic.sandbox :as sandbox])
    (def config-file "heretic.edn")
    (def heretic-dir ".heretic")

    (defn load-config []
      (if (fs/exists? config-file)
        (edn/read-string (slurp config-file))
        (throw (ex-info "Missing heretic.edn config file" {}))))

    (defn has-arg? [arg]
      (some (fn [a] (= a arg)) *command-line-args*))

    (defn run-with-clojurestorm
      [config code]
      (let [opts (sandbox/storm-jvm-opts config)
            ;; Convert JVM opts to -J flags for clj
            j-flags (mapv (fn [opt] (str "-J" opt)) opts)
            cmd (concat ["clj"] j-flags ["-M:collect" "-e" code])]
        (apply p/shell cmd))))

  heretic:collect
  {:doc "Collect test-to-code coverage mapping"
   :task
   (let [config (load-config)
         force? (has-arg? "--force")
         code (str "(require '[heretic.core :as heretic])"
                   "(heretic/collect! (heretic/load-config)"
                   (when force? " :force true")
                   ")"
                   "(System/exit 0)")]
     (run-with-clojurestorm config code))}

  heretic:status
  {:doc "Show stale test namespaces that need recollection"
   :task
   (do
     (println "Coverage status:")
     (if (fs/exists? heretic-dir)
       (let [coverage-dir (fs/file heretic-dir "coverage")]
         (if (fs/exists? coverage-dir)
           (let [files (fs/list-dir coverage-dir)
                 index-file (fs/file heretic-dir "index.edn")]
             (println (str "  Coverage files: " (count files)))
             (println (str "  Index exists: " (fs/exists? index-file)))
             (when (fs/exists? index-file)
               (let [index (edn/read-string (slurp (str index-file)))]
                 (println (str "  Test namespaces indexed: " (count (:included-test-ns index))))
                 (println (str "  Code locations tracked: " (count (:coord-to-tests index)))))))
           (println "  No coverage files found")))
       (println "  No .heretic directory found. Run heretic:collect first.")))}

  heretic:clean
  {:doc "Remove .heretic directory and all coverage data"
   :task
   (do
     (if (fs/exists? heretic-dir)
       (do
         (fs/delete-tree heretic-dir)
         (println "Removed" heretic-dir))
       (println "Nothing to clean - .heretic directory does not exist")))}

  heretic:mutate
  {:doc "Run mutation testing in an isolated sandbox copy (working tree untouched)"
   :task
   ;; Sandboxed by default (issue #2). The orchestrator JVM loads ONLY
   ;; heretic.sandbox (clojure.* deps) and spawns a storm-enabled child whose cwd
   ;; is the sandbox; loading heretic.core here would pull in heretic.tracer ->
   ;; clojure.storm.* and need the storm classpath the orchestrator avoids.
   (let [code (str "(require '[heretic.sandbox :as sb] '[clojure.edn :as edn])"
                   "(sb/mutate-in-sandbox! (edn/read-string (slurp \"heretic.edn\")))"
                   "(System/exit 0)")]
     (p/shell "clojure" "-M" "-e" code))}

  heretic:sandbox-clean
  {:doc "Remove the sandbox directory used by heretic:mutate"
   :task
   (println "Removed sandbox at" (sandbox/clean-sandbox! (load-config)))}

  heretic:survivors
  {:doc "Show surviving mutations from last run"
   :task
   (let [config (load-config)
         code (str "(require '[heretic.core :as heretic])"
                   "(require '[heretic.reporter :as reporter])"
                   "(let [survivors (heretic/survivors (heretic/load-config))]"
                   "  (if (seq survivors)"
                   "    (doseq [s survivors]"
                   "      (println (format \"  %s:%d %s -> %s\""
                   "                        (:file s) (:line s)"
                   "                        (:original s) (:replacement s))))"
                   "    (println \"No surviving mutations.\")))")]
     (run-with-clojurestorm config code))}

  heretic:watch
  {:doc "Watch source/test files; run a sandboxed mutation on each source change (working tree untouched)"
   :task
   ;; Storm-free orchestrator (like heretic:mutate); each change spawns the storm child.
   (let [code (str "(require '[heretic.watch :as watch] '[clojure.edn :as edn])"
                   "(watch/watch! (edn/read-string (slurp \"heretic.edn\")))")]
     (p/shell "clojure" "-M" "-e" code))}

  ;; Development tasks
  dev:repl
  {:doc "Start a development REPL with ClojureStorm"
   :task
   (let [config (load-config)
         opts (sandbox/storm-jvm-opts config)
         jvm-opts (str/join " " opts)]
     (p/shell {:extra-env {"JVM_OPTS" jvm-opts}}
              "clj" "-M:dev:clojurestorm" "-m" "nrepl.cmdline" "--interactive"))}

  test
  {:doc "Run tests with kaocha (slow, may hang with ClojureStorm)"
   :task
   (p/shell "clj" "-M:test")}

  test:fast
  {:doc "Run tests that don't require ClojureStorm (faster startup)"
   :task
   (let [;; Tests that work without ClojureStorm
         namespaces ["heretic.operators-test"
                     "heretic.parser-test"
                     "heretic.mutation-engine-test"
                     "heretic.equivalent-test"
                     "heretic.timing-test"
                     "heretic.subsumption-test"
                     "heretic.reporter-test"
                     "heretic.persistence-test"
                     "heretic.coord-mapper-test"
                     "heretic.form-bridge-test"
                     "heretic.reloader-test"
                     "heretic.incremental-test"
                     "heretic.killmatrix-test"
                     "heretic.process-worker-test"
                     "heretic.process-pool-test"
                     "heretic.sandbox-test"
                     "heretic.trends-test"]
         quote-ns (fn [ns] (str "(quote " ns ")"))
         require-forms (str/join " " (map quote-ns namespaces))
         run-forms (str/join " " (map quote-ns namespaces))
         code (str "(require 'clojure.test " require-forms ")"
                   "(let [summary (clojure.test/run-tests " run-forms ")]"
                   "  (println)"
                   "  (println \"Note: Tests requiring ClojureStorm skipped. Use 'bb test' for full suite.\")"
                   "  (System/exit (if (and (zero? (:fail summary)) (zero? (:error summary))) 0 1)))")]
     (p/shell "clj" "-Sdeps" "{:paths [\"src\" \"test\"]}" "-M" "-e" code))}

  ci
  {:doc "Run local CI: lint + unit tests in parallel."
   :task
   (let [checks [{:name "lint"
                  :cmd ["clj-kondo" "--parallel" "--lint" "src" "--fail-level" "warning"]}
                 {:name "test:unit"
                  :cmd ["clojure" "-M:test"]}]
         _ (println)
         _ (doseq [{:keys [name]} checks]
             (println (format "  … %s" name)))
         started (mapv (fn [{:keys [name cmd]}]
                         {:name name
                          :start (System/currentTimeMillis)
                          :proc (apply p/process {:out :string :err :string} cmd)})
                       checks)
         results (mapv (fn [{:keys [name start proc]}]
                         (let [r (deref proc)]
                           {:name name
                            :ok? (zero? (:exit r))
                            :elapsed (/ (- (System/currentTimeMillis) start) 1000.0)
                            :out (:out r)
                            :err (:err r)}))
                       started)]
     (println)
     (doseq [{:keys [name ok? elapsed out err]} results]
       (println (format "  %s %s  (%.1fs)" (if ok? "✓" "✗") name elapsed))
       (when-not ok?
         (when (seq out) (println out))
         (when (seq err) (println err))))
     (let [failed (remove :ok? results)]
       (if (seq failed)
         (do (println (format "\n%d of %d checks failed." (count failed) (count checks)))
             (System/exit 1))
         (println "\nAll checks passed."))))}

  ;; =============================================================================
  ;; Self-Testing
  ;; =============================================================================
  ;; Heretic mutation-tests itself by running the sandboxed pipeline against its
  ;; own source — the sandbox isolates the run, so no worktree/nREPL dance is
  ;; needed (this replaces the retired heretic.self-test/heretic.nrepl-runner
  ;; worktree machinery). Scoped to a small subset so the full-suite ClojureStorm
  ;; collect (which can hang) is avoided.

  self-test
  {:doc "Mutation-test Heretic on itself in a sandbox (scoped subset, avoids the full-suite ClojureStorm hang)"
   :task
   (let [code (str "(require '[heretic.sandbox :as sb] '[clojure.edn :as edn])"
                   "(sb/mutate-in-sandbox!"
                   "  (assoc (edn/read-string (slurp \"heretic.edn\")) :test-namespaces ['heretic.timing-test])"
                   "  :files [\"src/heretic/timing.clj\"])"
                   "(System/exit 0)")]
     (p/shell "clojure" "-M" "-e" code))}}}
