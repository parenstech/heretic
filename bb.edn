{:paths ["src" "bb"]

 :deps
 {rewrite-clj/rewrite-clj {:mvn/version "1.1.47"}}

 :tasks
 {:requires [[babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.edn :as edn]
             [clojure.string :as str]]

  :init
  (do
    (def config-file "heretic.edn")
    (def heretic-dir ".heretic")

    (defn load-config []
      (if (fs/exists? config-file)
        (edn/read-string (slurp config-file))
        (throw (ex-info "Missing heretic.edn config file" {}))))

    (defn clj-storm-opts [config]
      (let [prefixes (:instrument-prefixes config)
            skip-prefixes (:instrument-skip-prefixes config)]
        (cond-> ["-Dclojure.storm.instrumentEnable=true"]
          (seq prefixes)
          (conj (str "-Dclojure.storm.instrumentOnlyPrefixes="
                     (str/join "," prefixes)))
          (seq skip-prefixes)
          (conj (str "-Dclojure.storm.instrumentSkipPrefixes="
                     (str/join "," skip-prefixes))))))

    (defn has-arg? [arg]
      (some (fn [a] (= a arg)) *command-line-args*))

    (defn run-with-clojurestorm
      [config code]
      (let [opts (clj-storm-opts config)
            ;; Convert JVM opts to -J flags for clj
            j-flags (mapv (fn [opt] (str "-J" opt)) opts)
            cmd (concat ["clj"] j-flags ["-M:collect" "-e" code])]
        (apply p/shell cmd))))

  heretic:collect
  {:doc "Collect test-to-code coverage mapping"
   :task
   (let [config (load-config)
         force? (has-arg? "--force")
         code (str "(require '[heretic.core :as heretic])"
                   "(heretic/collect! (heretic/load-config)"
                   (when force? " :force true")
                   ")"
                   "(System/exit 0)")]
     (run-with-clojurestorm config code))}

  heretic:status
  {:doc "Show stale test namespaces that need recollection"
   :task
   (do
     (println "Coverage status:")
     (if (fs/exists? heretic-dir)
       (let [coverage-dir (fs/file heretic-dir "coverage")]
         (if (fs/exists? coverage-dir)
           (let [files (fs/list-dir coverage-dir)
                 index-file (fs/file heretic-dir "index.edn")]
             (println (str "  Coverage files: " (count files)))
             (println (str "  Index exists: " (fs/exists? index-file)))
             (when (fs/exists? index-file)
               (let [index (edn/read-string (slurp (str index-file)))]
                 (println (str "  Test namespaces indexed: " (count (:included-test-ns index))))
                 (println (str "  Code locations tracked: " (count (:coord-to-tests index)))))))
           (println "  No coverage files found")))
       (println "  No .heretic directory found. Run heretic:collect first.")))}

  heretic:clean
  {:doc "Remove .heretic directory and all coverage data"
   :task
   (do
     (if (fs/exists? heretic-dir)
       (do
         (fs/delete-tree heretic-dir)
         (println "Removed" heretic-dir))
       (println "Nothing to clean - .heretic directory does not exist")))}

  heretic:mutate
  {:doc "Run mutation testing on source files"
   :task
   (let [config (load-config)
         code (str "(require '[heretic.core :as heretic])"
                   "(heretic/mutate! (heretic/load-config))"
                   "(System/exit 0)")]
     (run-with-clojurestorm config code))}

  heretic:survivors
  {:doc "Show surviving mutations from last run"
   :task
   (let [config (load-config)
         code (str "(require '[heretic.core :as heretic])"
                   "(require '[heretic.reporter :as reporter])"
                   "(let [survivors (heretic/survivors (heretic/load-config))]"
                   "  (if (seq survivors)"
                   "    (doseq [s survivors]"
                   "      (println (format \"  %s:%d %s -> %s\""
                   "                        (:file s) (:line s)"
                   "                        (:original s) (:replacement s))))"
                   "    (println \"No surviving mutations.\")))")]
     (run-with-clojurestorm config code))}

  heretic:watch
  {:doc "Watch source and test files for changes, run mutations on change"
   :task
   (let [config (load-config)
         code (str "(require '[heretic.watch :as watch])"
                   "(require '[heretic.core :as heretic])"
                   "(watch/watch! (heretic/load-config))")]
     (run-with-clojurestorm config code))}

  ;; Development tasks
  dev:repl
  {:doc "Start a development REPL with ClojureStorm"
   :task
   (let [config (load-config)
         opts (clj-storm-opts config)
         jvm-opts (str/join " " opts)]
     (p/shell {:extra-env {"JVM_OPTS" jvm-opts}}
              "clj" "-M:dev:clojurestorm" "-m" "nrepl.cmdline" "--interactive"))}

  test
  {:doc "Run tests with kaocha (slow, may hang with ClojureStorm)"
   :task
   (p/shell "clj" "-M:test")}

  test:fast
  {:doc "Run tests that don't require ClojureStorm (faster startup)"
   :task
   (let [;; Tests that work without ClojureStorm
         namespaces ["heretic.operators-test"
                     "heretic.parser-test"
                     "heretic.mutation-engine-test"
                     "heretic.equivalent-test"
                     "heretic.timing-test"
                     "heretic.subsumption-test"
                     "heretic.reporter-test"
                     "heretic.persistence-test"
                     "heretic.coord-mapper-test"
                     "heretic.form-bridge-test"
                     "heretic.reloader-test"
                     "heretic.incremental-test"
                     "heretic.trends-test"]
         quote-ns (fn [ns] (str "(quote " ns ")"))
         require-forms (str/join " " (map quote-ns namespaces))
         run-forms (str/join " " (map quote-ns namespaces))
         code (str "(require 'clojure.test " require-forms ")"
                   "(let [summary (clojure.test/run-tests " run-forms ")]"
                   "  (println)"
                   "  (println \"Note: Tests requiring ClojureStorm skipped. Use 'bb test' for full suite.\")"
                   "  (System/exit (if (and (zero? (:fail summary)) (zero? (:error summary))) 0 1)))")]
     (p/shell "clj" "-Sdeps" "{:paths [\"src\" \"test\"]}" "-M" "-e" code))}

  ;; =============================================================================
  ;; Self-Testing Infrastructure
  ;; =============================================================================
  ;; Heretic tests itself using a git worktree to avoid self-corruption.
  ;; The mutation engine runs in one JVM, tests run in worktree via nREPL.

  self-test:setup
  {:doc "Create worktree for self-testing and show REPL start instructions"
   :task
   (let [worktree-path "../heretic-under-test"
         worktree-abs (str (fs/absolutize worktree-path))]
     (if (fs/exists? worktree-path)
       (do
         (println "Worktree already exists at" worktree-abs)
         (println "")
         (println "To start the worktree REPL:")
         (println (str "  cd " worktree-abs))
         (println "  clj -M:dev:test:clojurestorm -m nrepl.cmdline --interactive")
         (println "")
         (println "Note the port number, then run:")
         (println "  bb self-test --port <PORT>"))
       (do
         (println "Creating worktree at" worktree-abs "...")
         (p/shell "git" "worktree" "add" worktree-path "HEAD")
         (println "")
         (println "Worktree created! Now start the worktree REPL:")
         (println (str "  cd " worktree-abs))
         (println "  clj -M:dev:test:clojurestorm -m nrepl.cmdline --interactive")
         (println "")
         (println "Note the port number, then run:")
         (println "  bb self-test --port <PORT>"))))}

  self-test:cleanup
  {:doc "Remove the self-testing worktree"
   :task
   (let [worktree-path "../heretic-under-test"]
     (if (fs/exists? worktree-path)
       (do
         ;; Reset any leftover mutations first
         (println "Resetting any leftover mutations...")
         (p/shell {:dir worktree-path :continue true} "git" "checkout" ".")
         (println "Removing worktree...")
         (p/shell "git" "worktree" "remove" "--force" worktree-path)
         (println "Worktree removed."))
       (println "No worktree found at" worktree-path)))}

  self-test
  {:doc "Run mutation testing on Heretic itself via worktree nREPL"
   :task
   (let [;; Parse --port argument
         port-idx (.indexOf (vec *command-line-args*) "--port")
         port (when (and (>= port-idx 0)
                         (< (inc port-idx) (count *command-line-args*)))
                (parse-long (nth *command-line-args* (inc port-idx))))

         ;; Parse --file argument (optional, for testing specific file)
         file-idx (.indexOf (vec *command-line-args*) "--file")
         target-file (when (and (>= file-idx 0)
                                (< (inc file-idx) (count *command-line-args*)))
                       (nth *command-line-args* (inc file-idx)))

         ;; Parse --limit argument (optional, limit number of mutations)
         limit-idx (.indexOf (vec *command-line-args*) "--limit")
         limit (when (and (>= limit-idx 0)
                          (< (inc limit-idx) (count *command-line-args*)))
                 (parse-long (nth *command-line-args* (inc limit-idx))))

         worktree-path "../heretic-under-test"]
     (cond
       (not port)
       (do
         (println "Usage: bb self-test --port <PORT> [--file <FILE>] [--limit <N>]")
         (println "")
         (println "First run 'bb self-test:setup' and start the worktree REPL."))

       (not (fs/exists? worktree-path))
       (do
         (println "Worktree not found. Run 'bb self-test:setup' first."))

       :else
       (let [config (load-config)
             worktree-abs (str (fs/absolutize worktree-path))
             code (str "(require '[heretic.self-test :as st])"
                       "(st/run-self-test! "
                       "{:port " port
                       " :worktree-path \"" worktree-abs "\""
                       (when target-file (str " :file \"" target-file "\""))
                       (when limit (str " :limit " limit))
                       "})")]
         (run-with-clojurestorm config code))))}

  self-test:status
  {:doc "Check self-testing setup status"
   :task
   (let [worktree-path "../heretic-under-test"
         worktree-abs (str (fs/absolutize worktree-path))]
     (println "Self-test status:")
     (println "")
     (if (fs/exists? worktree-path)
       (do
         (println "  Worktree: " worktree-abs)
         (println "  Status: READY")
         (println "")
         (println "To start testing:")
         (println "  1. cd" worktree-abs)
         (println "  2. clj -M:dev:test:clojurestorm -m nrepl.cmdline --interactive")
         (println "  3. bb self-test --port <PORT>"))
       (do
         (println "  Worktree: NOT FOUND")
         (println "")
         (println "Run 'bb self-test:setup' to create the worktree."))))}}}
